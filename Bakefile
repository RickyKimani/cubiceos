task templ:
  description: Compile & fmt .templ files
  cmd: 
      templ generate
      templ fmt ./...

task tailwind:
  description: Compile & fmt .css & .js files
  cmd: 
    npx @tailwindcss/cli -i ./internal/web/assets/css/input.css -o ./internal/web/assets/css/output.css
    prettier --write "**/*.{js, css}"
    
task run:
  description: Run the web server
  deps: tailwind@cc, templ@cc
  cmd: 
      go fmt ./...
      go run ./cmd/eos-cli --http